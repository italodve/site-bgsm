# Chave da Anthropic (obrigatória para o chat do site funcionar)
ANTHROPIC_API_KEY=

# WhatsApp da Imobiliária Vilas Cabral usado pelo agente de IA no handoff (somente dígitos, com
# DDI, ex.: 5511971331539). Use o MESMO número na constante numeroEmpresa de
# public/script.js e nos links wa.me de public/index.html.
WHATSAPP_EMPRESA=

# Segredo longo e aleatório usado para assinar tokens de chat e o cookie do painel
CHAT_SESSION_SECRET=change-this-long-random-secret

PORT=3000

# Login do painel (/painel). PAINEL_PASSWORD é obrigatória para acessar o
# painel; sem ela o login responde 503. PAINEL_USER padrão: admin.
PAINEL_USER=admin
PAINEL_PASSWORD=

# Pasta onde fica o banco SQLite (imob.db). Na Railway, crie um Volume,
# monte em /data e defina DATA_DIR=/data para os dados sobreviverem a deploys.
# Local: deixe vazio para usar ./data.
DATA_DIR=

# Opcional: domínios EXTERNOS extras autorizados a chamar a API, separados
# por vírgula. O site e o painel servidos por este próprio servidor já são
# aceitos automaticamente (same-origin) — não precisam ser listados aqui.
ALLOWED_ORIGIN=
